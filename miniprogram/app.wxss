page {
  --color-bg: #f7f4ec;
  --color-surface: #fffcf6;
  --color-primary: #167d73;
  --color-primary-soft: #dff1ed;
  --color-accent: #e3a33e;
  --color-danger: #c84b4b;
  --color-text: #27312f;
  --color-muted: #75807d;
  --color-line: #e8e3d8;
  --radius-card: 28rpx;
  --shadow-card: 0 10rpx 34rpx rgba(52, 66, 62, 0.08);

  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 30rpx;
}

button {
  font: inherit;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.25;
  margin: 0;
}

.page-subtitle {
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}

.network-banner,
.cache-banner {
  border-radius: 16rpx;
  font-size: 23rpx;
  line-height: 1.5;
  margin: 18rpx 0;
  padding: 16rpx 20rpx;
}

.network-banner {
  background: #fff1d6;
  color: #765315;
}

.cache-banner {
  background: #eaf4f1;
  color: #34645e;
}

.surface-card {
  background: var(--color-surface);
  border: 1rpx solid rgba(232, 227, 216, 0.9);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.primary-button,
.secondary-button {
  align-items: center;
  border-radius: 24rpx;
  box-sizing: border-box;
  display: flex;
  font-size: 30rpx;
  font-weight: 650;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
}

.primary-button {
  background: var(--color-primary);
  color: #fff;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.secondary-button {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.empty-state {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 58vh;
  padding: 40rpx;
  text-align: center;
}

.empty-state__mark {
  align-items: center;
  background: var(--color-primary-soft);
  border-radius: 50%;
  color: var(--color-primary);
  display: flex;
  font-size: 52rpx;
  height: 132rpx;
  justify-content: center;
  margin-bottom: 34rpx;
  width: 132rpx;
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.6;
}

.empty-state__description {
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.65;
  margin: 14rpx 0 38rpx;
}

.error-banner {
  background: #fff0ed;
  border-radius: 20rpx;
  color: var(--color-danger);
  font-size: 26rpx;
  line-height: 1.55;
  margin: 24rpx 0;
  padding: 22rpx 24rpx;
}

.skeleton {
  animation: skeleton-pulse 1.4s ease-in-out infinite;
  background: #e9e6df;
  border-radius: 16rpx;
}

@keyframes skeleton-pulse {
  50% {
    opacity: 0.55;
  }
}
