<view class="page-shell invite-page">
  <view class="search-card surface-card">
    <input class="search-input" placeholder="搜索好友姓名或 ID" value="{{query}}" bindinput="handleQueryInput" />
  </view>

  <view wx:if="{{noticeMessage}}" class="notice-banner">{{noticeMessage}}</view>
  <view wx:if="{{errorMessage}}" class="error-banner">{{errorMessage}}</view>
  <view wx:if="{{loading}}" class="skeleton invite-skeleton"></view>
  <view wx:elif="{{friends.length === 0}}" class="empty-state">
    <view class="empty-state__mark">友</view>
    <view class="empty-state__title">暂无可邀请的好友</view>
    <view class="empty-state__description">先在“消息—好友”中通过账号 ID 添加好友。</view>
  </view>
  <view wx:else class="friend-list surface-card">
    <view wx:for="{{friends}}" wx:key="userId" wx:if="{{item.visible}}" class="select-row" data-user-id="{{item.userId}}" bindtap="toggleFriend">
      <view class="select-check {{item.selected ? 'select-check--active' : ''}}">{{item.selected ? '✓' : ''}}</view>
      <view>
        <view class="friend-name">{{item.displayName}}</view>
        <view class="friend-id">ID {{item.publicId}}</view>
      </view>
    </view>
  </view>

  <button wx:if="{{friends.length > 0}}" class="primary-button submit-invites" loading="{{saving}}" disabled="{{saving}}" bindtap="handleSubmit">发送邀请</button>
</view>
