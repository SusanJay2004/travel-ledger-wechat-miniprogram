.search-card {
  margin-bottom: 24rpx;
  padding: 12rpx 26rpx;
}

.search-input {
  font-size: 27rpx;
  height: 70rpx;
}

.invite-skeleton {
  height: 260rpx;
}

.friend-list {
  overflow: hidden;
  padding: 0 28rpx;
}

.select-row {
  align-items: center;
  border-bottom: 1rpx solid var(--color-line);
  display: flex;
  min-height: 100rpx;
}

.select-check {
  border: 2rpx solid #b9c1be;
  border-radius: 50%;
  box-sizing: border-box;
  color: #fff;
  font-size: 20rpx;
  height: 42rpx;
  line-height: 38rpx;
  margin-right: 20rpx;
  text-align: center;
  width: 42rpx;
}

.select-check--active {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.friend-name {
  font-size: 28rpx;
  font-weight: 650;
}

.friend-id {
  color: var(--color-muted);
  font-size: 21rpx;
  margin-top: 8rpx;
}

.submit-invites {
  margin-top: 34rpx;
  width: 100%;
}
