{
  "name": "travel-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "同行账本微信小程序",
  "license": "MIT",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "cloudfunctions/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "cloud:smoke-packages": "npm run build && node scripts/smoke-cloud-packages.mjs",
    "cloud:config:prepare": "node scripts/cloud-private-config.mjs prepare",
    "cloud:config:check": "node scripts/cloud-private-config.mjs check",
    "cloud:infra:check": "node scripts/cloud-infrastructure.mjs check",
    "cloud:infra:apply": "node scripts/cloud-infrastructure.mjs apply",
    "cloud:deploy": "node scripts/deploy-cloud-functions.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "security:cloud-locks": "node scripts/check-cloud-locks.mjs",
    "security:cloud-config": "node scripts/check-cloud-deployment-config.mjs",
    "security:cloud-indexes": "node scripts/check-cloud-indexes.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format && npm run security:cloud-locks && npm run security:cloud-config && npm run security:cloud-indexes && npm run security:secrets && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.30.0",
    "miniprogram-api-typings": "^4.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.0"
  }
}
