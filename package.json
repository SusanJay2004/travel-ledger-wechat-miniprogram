{
  "name": "travel-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "同行账本微信小程序",
  "license": "MIT",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "cloudfunctions/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "cloud:smoke-packages": "npm run build && node scripts/smoke-cloud-packages.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "security:cloud-locks": "node scripts/check-cloud-locks.mjs",
    "security:cloud-config": "node scripts/check-cloud-deployment-config.mjs",
    "security:cloud-indexes": "node scripts/check-cloud-indexes.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format && npm run security:cloud-locks && npm run security:cloud-config && npm run security:cloud-indexes && npm run security:secrets && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.7.0",
    "miniprogram-api-typings": "^5.2.1",
    "prettier": "^3.6.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.1.10"
  }
}
