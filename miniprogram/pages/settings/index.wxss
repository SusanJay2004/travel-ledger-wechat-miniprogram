.settings-page {
  padding-top: 30rpx;
}

.settings-card,
.danger-card {
  overflow: hidden;
}

.settings-row {
  align-items: center;
  border-bottom: 1rpx solid var(--color-line);
  display: flex;
  font-size: 28rpx;
  justify-content: space-between;
  min-height: 100rpx;
  padding: 0 28rpx;
}

.settings-action {
  background: transparent;
  border-radius: 0;
  color: var(--color-primary);
  font-size: 28rpx;
  line-height: 100rpx;
  min-height: 100rpx;
}

.settings-action::after {
  border: 0;
}

.danger-card {
  margin-top: 28rpx;
  padding: 30rpx;
}

.danger-title {
  color: var(--color-danger);
  font-size: 28rpx;
  font-weight: 700;
}

.danger-copy {
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 14rpx;
}

.delete-account {
  background: #fff0ed;
  border-radius: 18rpx;
  color: var(--color-danger);
  font-size: 25rpx;
  margin-top: 28rpx;
}

.delete-account::after {
  border: 0;
}
